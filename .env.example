# Copy to .env and fill in. Docker Compose reads POSTGRES_* from .env as well.
POSTGRES_USER=yes_dev
POSTGRES_PASSWORD=change-me
POSTGRES_DB=yes_dev_test
POSTGRES_PORT=5433
DATABASE_URL="postgresql://yes_dev:change-me@localhost:5433/yes_dev_test?schema=public"

# Used only by `npm run db:seed` to create the first Super Admin
SEED_SUPER_ADMIN_NAME="Super Admin"
SEED_SUPER_ADMIN_EMAIL="superadmin@example.com"
SEED_SUPER_ADMIN_PASSWORD="change-me"

# Signs the login session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me"
